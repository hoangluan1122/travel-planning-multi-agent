# demo uses fictional fixtures, never real-time data
TRAVELMATE_MODE=demo
TRAVELMATE_API_TOKEN=
TRAVELMATE_AGENT_TIMEOUT=45
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# LLM agent engine: adk (Google ADK) or maf (Microsoft Agent Framework, needs --extra maf).
# Applies to planner, routed planner, recommendation and Place Agent. PLANNER_ENGINE still works.
AGENT_ENGINE=adk
# Live Place UI: tool_workflow (no LLM), adk_llm or maf_llm
LIVE_PLACE_MODE=tool_workflow
# itinerary API pipeline: classic (asyncio), workflow (MAF Workflow graph, needs --extra maf)
# or planning (Planning pattern: LLM decomposes the request and re-plans; see docs/planning-pattern.md)
TRAVELMATE_ORCHESTRATOR=classic
# live place/weather source: google (needs GOOGLE_MAPS_API_KEY) or open_data (OSM + Open-Meteo, no key)
TRAVELMATE_PLACE_PROVIDER=google
# saved preferences used by the itinerary API (read-only); leave empty for request-only memory
TRAVELMATE_MEMORY_USER=
TRAVELMATE_MEMORY_DB=agent-memory.sqlite3
# OpenTelemetry traces: off, console or otlp (set OTEL_EXPORTER_OTLP_ENDPOINT); needs --extra maf
TRAVELMATE_TELEMETRY=off

# Product data: accounts, saved trips, favourites, reviews.
# PostgreSQL (needs: uv sync --extra postgres), e.g. postgresql://postgres:<mật khẩu>@localhost:5432/travelmate
TRAVELMATE_DATABASE_URL=
# Used only when TRAVELMATE_DATABASE_URL is empty: one SQLite file (gitignored)
TRAVELMATE_DB=travelmate.sqlite3
# The account that signs up with this email becomes an admin
TRAVELMATE_ADMIN_EMAIL=
TRAVELMATE_SIGNUP_OPEN=true
# Optional: send password-reset emails (free with a Gmail app password); empty = link in the server log
TRAVELMATE_SMTP_HOST=
TRAVELMATE_SMTP_PORT=587
TRAVELMATE_SMTP_USER=
TRAVELMATE_SMTP_PASSWORD=
TRAVELMATE_SMTP_FROM=

# Public site (see docs/deploy.md). The https:// address the site is served at: used in
# password-reset links, the sitemap and share previews. Empty = the address of each request.
TRAVELMATE_PUBLIC_URL=
# Shown on the terms and privacy pages; leave empty to show only the contact form
TRAVELMATE_OPERATOR_NAME=
TRAVELMATE_CONTACT_EMAIL=
# AI uses per signed-in user per day (Vietnam time); 0 = no limit. Admins and the operator token are not limited.
TRAVELMATE_DAILY_PLANS=10
TRAVELMATE_DAILY_CHATS=60
