# demo uses fictional fixtures, never real-time data
TRAVELMATE_MODE=demo
TRAVELMATE_API_TOKEN=
TRAVELMATE_AGENT_TIMEOUT=45
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# LLM agent engine: adk (Google ADK) or maf (Microsoft Agent Framework, needs --extra maf).
# Applies to planner, routed planner, recommendation and Place Agent. PLANNER_ENGINE still works.
AGENT_ENGINE=adk
# Live Place UI: tool_workflow (no LLM), adk_llm or maf_llm
LIVE_PLACE_MODE=tool_workflow
# itinerary API pipeline: classic (asyncio) or workflow (MAF Workflow graph, needs --extra maf)
TRAVELMATE_ORCHESTRATOR=classic
# saved preferences used by the itinerary API (read-only); leave empty for request-only memory
TRAVELMATE_MEMORY_USER=
TRAVELMATE_MEMORY_DB=agent-memory.sqlite3
# OpenTelemetry traces: off, console or otlp (set OTEL_EXPORTER_OTLP_ENDPOINT); needs --extra maf
TRAVELMATE_TELEMETRY=off

